# Arbitr AI — пример переменных окружения
# Скопируйте в .env и заполните реальными значениями (или через Harness)

# === Application ===
APP_NAME=Arbitr AI
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=dev

# === Database ===
DATABASE_URL=postgresql+asyncpg://Arbitr AI:Arbitr AI@localhost:5432/Arbitr AI
DATABASE_ECHO=false

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === MinIO ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=Arbitr AI

# === JWT ===
SECRET_KEY=change-me-in-production-use-harness-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === LLM ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=

# === Интеграции ===
FNS_API_KEY=
FNS_API_URL=https://api-fns.ru
ROSREESTR_API_KEY=
ROSREESTR_API_URL=
FSSP_API_KEY=
FSSP_API_URL=
POST_API_TOKEN=
POST_API_URL=https://api.pochta.ru

# === SMTP ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]